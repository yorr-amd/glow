{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glow",
  "version": "1.1.0",
  "identifier": "com.glow.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glow ✦ Skincare Tracker",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#FDF5F7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/yorr-amd/glow/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QTQ3RjBDQ0VFRkY0QzcKUldUSDlPL09ESCtreHNpYzVCcGMraHR3aFhJcldVZVlvbVFRQmF5MGhlT3Jaam93dVZsamsxWDQK"
    }
  }
}
